TYPESAFE_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# JEV_MODEL=jev-latest
# OPENAI_MODEL=gpt-5
# SC2MIND_MEMORY_DIR=memory
# S1_INTERVAL_S=2.0
# SC2MIND_MULTI_SQUAD=true
# SQUAD_INTERVAL_S=3.0
# SQUAD_MAX_AGE_S=6.0
# S1_MIN_CONFIDENCE=0.45
# S1_REPLAN_THRESHOLD=0.7
# S2_INTERVAL_S=45
# S2_MIN_INTERVAL_S=15
# S1_TIMEOUT_S=3
# S2_TIMEOUT_S=30
# S1_MAX_AGE_S=8
# S2_MAX_AGE_S=120
# ANALYSIS_TIMEOUT_S=120
# SC2PATH=/Applications/StarCraft II
# For Docker: path to an extracted Linux SC2 installation
# SC2_INSTALL_DIR=./runtime/StarCraftII
# On Apple Silicon, use the bundled QEMU runner for the Linux engine
# SC2_ENGINE_RUNNER=/usr/local/bin/sc2-qemu
